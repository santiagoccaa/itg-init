{
    "vtex.menu@2.x:menu#desktop__header__menu-categoryes": {
        "title": "drop-down menu header",
        "children": [
            "menu-item#menu-categories"
        ]
    },
    "menu-item#menu-categories": {
        "title": "all categories",
        "props": {
            "id": "menu-item-shop",
            "type": "custom",
            "highlight": false,
            "itemProps": {
                "type": "internal",
                "noFollow": false
            },
            "iconProps": {
                "id": "hpa-hamburguer-menu",
                "size": 16,
                "viewBox": "0 0 16 16",
                "activeClassName": "rebel-pink",
                "mutedClassName": "c-action-primary"
            },
            "iconToTheRight": true,
            "blockClass": "menu-icon-header"
        },
        "blocks": [
            "vtex.menu@2.x:submenu#menu-categoies--list"
        ]
    },
    "vtex.menu@2.x:submenu#menu-categoies--list": {
        "children": [
            "vtex.menu@2.x:menu#list--categories"
        ]
    },
    "vtex.menu@2.x:menu#list--categories": {
        "children": [
            "menu-item#Deals",
            "menu-item#Grocery",
            "menu-item#new-year-goals",
            "menu-item#valentines-day",
            "menu-item#game-time",
            "menu-item#clothing-shoes-accessories",
            "menu-item#electronics",
            "menu-item#home-furniture-appliances",
