{
    "flex-layout.row#desktop__header": {
        "title": "header desktop",
        "children": [
            "flex-layout.col#desktop__header--navigation-content"
        ],
        "props": {
            "blockClass": "desktop__header"
        }
    },
    "flex-layout.col#desktop__header--navigation-content": {
        "title": "content header",
        "children": [
            "flex-layout.row#navigation-content__top-menu",
            "flex-layout.row#desktop__header--bottom-menu"
        ]
    },
    "flex-layout.row#navigation-content__top-menu": {
        "title": "header menu superior",
        "children": [
            "flex-layout.row#navigationcontent__logo",
            "search-bar#top-menu--search",
            "flex-layout.row#desktop__header--navigation-links",
            "flex-layout.row#desktop__header--login"
        ],
        "props": {
            "maxWidth": "1280px",
            "height": "168px",
            "blockClass": "navigation-content__top-menu"
        }
    },
    "search-bar#top-menu--search": {
        "title": "buscador del header",
        "props":{
            "placeholder":"Search products"
        }
    },
    "flex-layout.row#navigationcontent__logo": {
        "children": [
            "logo#logo--menu",
            "logo"
        ],
        "props": {
            "blockClass": "navigationcontent__logo",
            "width": "10%"
        }
    },
    "logo#logo--menu": {
        "props": {
            "width": 132,
            "height": 32,
            "url": "assets/icons/menu.svg"
        }
    },
    "logo": {
        "props": {
            "width": 132,
            "height": 20,
            "url": "assets/icons/icon.svg"
        }
    },
    "flex-layout.row#desktop__header--navigation-links": {
        "children": [
            "rich-text#navigation-links__trends",
            "rich-text#navigation-links--collection",
            "rich-text#navigation-links--offers",
            "rich-text#navigation-links--monday",
            "rich-text#navigation-links--never-say-never"
        ],
        "props": {
            "blockClass": "desktop__header--navigation-links",
            "colSizing": "auto",
            "colGap": "4"
        }
    },
    "rich-text#navigation-links__trends": {
        "props": {
            "text": "Tendencias de ItGlobers",
            "blockClass": "navigation-links"
        }
    },
    "rich-text#navigation-links--collection": {
        "props": {
            "text": "Colección del mes",
            "blockClass": "navigation-links"
        }
    },
    "rich-text#navigation-links--offers": {
        "props": {
            "text": "Ofertas de enero",
            "blockClass": "navigation-links"
        }
    },
    "rich-text#navigation-links--monday": {
        "props": {
            "text": "Cyber Monday",
            "blockClass": "navigation-links"
        }
    },
    "rich-text#navigation-links--never-say-never": {
        "props": {
            "text": "Never say never",
            "blockClass": "navigation-links"
        }
    },
    "flex-layout.row#desktop__header--login": {
        "children": [
            "image#login--icon-cart",
            "link#login--button-login"
        ],
        "props": {
            "width": "15%",
            "blockClass": "desktop__header--login"
        }
    },
    "image#login--icon-cart": {
        "props": {
            "src": "assets/icons/cart.svg",
            "width": "20px",
            "height": "20px"
        }
    },
    "link#login--button-login": {
        "props": {
            "href": "/",
            "label": "Login",
            "blockClass": "login--button-login"
        }
    },
    "flex-layout.row#desktop__header--bottom-menu": {
        "title": "Category Navigation",
        "children": [
            "flex-layout.col#bottom-menu__category--food",
            "flex-layout.col#bottom-menu__category--fitness",
            "flex-layout.col#bottom-menu__category--arctic",
            "flex-layout.col#bottom-menu__category--poolday",
            "flex-layout.col#bottom-menu__category--hotel",
            "flex-layout.col#bottom-menu__category--house",
            "flex-layout.col#bottom-menu__category--nature",
            "flex-layout.col#bottom-menu__category--closet",
            "flex-layout.col#bottom-menu__category--beache",
            "flex-layout.col#bottom-menu__category--mountaineering",
            "flex-layout.col#bottom-menu__category--delivery"
        ],
        "props": {
            "blockClass": "desktop__header--bottom-menu",
            "colSizing": "70px"
        }
    },
    "flex-layout.col#bottom-menu__category--food": {
        "children": [
            "image#food--icon",
            "rich-text#food-label"
        ],
        "props": {
            "blockClass": "bottom-menu__category"
        }
    },
    "image#food--icon": {
        "props": {
            "src": "assets/img/navbar/fastfood.svg",
            "width": "20px",
            "height": "20px"
        }
    },
    "rich-text#food-label": {
        "props": {
            "text": "Food",
            "blockClass": "category-description"
        }
    },
    "flex-layout.col#bottom-menu__category--fitness": {
        "children": [
            "image#fitness-icon",
