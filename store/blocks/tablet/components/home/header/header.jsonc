{
    "flex-layout.row#tablet__header": {
        "title": "tablet Header",
        "children": [
            "flex-layout.col#tablet__header--menu"
        ],
        "props": {
            "blockClass": "tablet__header",
            "height": "168px"
        }
    },
    "flex-layout.col#tablet__header--menu": {
        "children": [
            "flex-layout.row#tablet__header--menu-bottom",
            "flex-layout.row#tablet__header--menu-button"
        ],
        "props": {
            "blockClass": "tablet__header--menu"
        }
    },
    "flex-layout.row#tablet__header--menu-bottom": {
        "title": "tablet header content",
        "children": [
            "image#tablet--menu-bottom--logo",
            "search-bar#tablet--menu-pper--search",
            "flex-layout.row#tablet--menu-bottom--navbar",
            "image#tablet--menu-bottom--cart",
            "login#tablet--menu-bottom--button-login"
        ],
        "props": {
            "blockClass": "tablet_header--menu-bottom",
            "colSizing": "auto"
        }
    },
    "image#tablet--menu-bottom--logo": {
        "title": "logo it globers",
        "props": {
            "width": "32px",
            "height": "16px",
            "src": "assets/img/icons/icon.svg"
        }
    },
    "search-bar#tablet--menu-pper--search": {
        "title": "search navbar",
        "props": {
            "openAutocompleteOnFocus": false,
            "width": "280px",
            "placeholder": "Search products",
            "blockClass": "tablet--menu-pper--search"
        }
    },
    "flex-layout.row#tablet--menu-bottom--navbar": {
        "title": "navbar menu bottom header",
        "children": [
            "rich-text#tablet--navbar-text1",
            "rich-text#tablet--navbar-text2",
            "rich-text#tablet--navbar-text3",
            "rich-text#tablet--navbar-text4",
            "rich-text#tablet--navbar-text5"
        ],
        "props": {
            "blockClass": "menu-bottom-navbar",
            "colSizing": "auto"
        }
    },
    "rich-text#tablet--navbar-text1": {
        "props": {
            "text": "Tendencias de ITGlobers",
            "blockClass": "navbar-text"
        }
    },
    "rich-text#tablet--navbar-text2": {
        "props": {
            "text": "Colección del mes",
            "blockClass": "navbar-text"
        }
    },
    "rich-text#tablet--navbar-text3": {
        "props": {
            "text": "Ofertas enero",
            "blockClass": "navbar-text"
        }
    },
    "rich-text#tablet--navbar-text4": {
        "props": {
            "text": "Cyber Monday",
            "blockClass": "navbar-text"
        }
    },
    "rich-text#tablet--navbar-text5": {
        "props": {
            "text": "Never say never",
            "blockClass": "navbar-text"
        }
    },
    "image#tablet--menu-bottom--cart": {
        "title": "Icono cart",
        "props": {
            "width": "20px",
            "height": "20px",
            "src": "assets/img/icons/delivery.svg"
        }
    },
    "login#tablet--menu-bottom--button-login": {
        "title": "button login",
        "props": {
            "iconLabel": "Login",
            "emailAndPasswordTitle": "LOG-IN",
            "accessCodeTitle": "Acess Code LOG-IN",
            "emailPlaceholder": "e-mail",
            "passwordPlaceholder": "password",
            "showPasswordVerificationIntoTooltip": true
        }
    },
    // Menu button
    "flex-layout.row#tablet__header--menu-button": {
        "children": [
            "flex-layout.row#tablet__header--menu-categorys"
        ],
        "props": {
            "blockClass": "tablet__header--menu-button",
            "width": "280px",
            "height": "40px"
        }
    },
    // row categorys
    "flex-layout.row#tablet__header--menu-categorys": {
        "children": [
            "flex-layout.col#tablet--menu-categorys#1",
            "flex-layout.col#tablet--menu-categorys#2",
            "flex-layout.col#tablet--menu-categorys#3",
            "flex-layout.col#tablet--menu-categorys#4",
            "flex-layout.col#tablet--menu-categorys#5",
            "flex-layout.col#tablet--menu-categorys#6",
            "flex-layout.col#tablet--menu-categorys#7",
            "flex-layout.col#tablet--menu-categorys#8",
            "flex-layout.col#tablet--menu-categorys#9",
            "flex-layout.col#tablet--menu-categorys#10",
            "flex-layout.col#tablet--menu-categorys#11",
            "flex-layout.col#tablet--menu-categorys#12"
        ],
        "props": {
            "blockClass": "tablet__header--menu-categorys",
            "colSizing": "auto"
        }
    },
    // item #1
    "flex-layout.col#tablet--menu-categorys#1": {
        "children": [
            "image#tablet--category--image#1",
            "rich-text#tablet--category--text#1"
        ],
        "props": {
            "blockClass": "tablet--menu-categorys"
        }
    },
    "image#tablet--category--image#1": {
        "title": "logo it globers",
        "props": {
            "width": "20px",
            "height": "20px",
            "src": "assets/img/header/fastfood.svg"
        }
    },
    "rich-text#tablet--category--text#1": {
        "props": {
            "text": "Food",
            "blockClass": "tablet--category--text"
        }
    },
