{
    "flex-layout.row#tablet": {
        "children": [
            "image#tablet--image-left",
            "flex-layout.col#tablet--center-text",
            "image#tablet--image-right"
        ],
        "props": {
            "blockClass": "tablet"
        }
    },
    "image#tablet--image-left": {
        "props": {
            "src": "assets/img/hero/img-left.svg",
            "blockClass": "tablet--image-left"
        }
    },
    "image#tablet--image-right": {
        "props": {
            "src": "assets/img/hero/img-right.svg",
            "blockClass": "tablet--image-right"
        }
    },
    "flex-layout.col#tablet--center-text": {
        "children": [
            "rich-text#tablet--center-text--title",
            "rich-text#tablet--center-text--subtitle",
            "rich-text#tablet--center-text--description",
            "link#tablet--center-text--button-shop"
        ],
        "props": {
            "blockClass": "desktop__hero--center-text",
            "conSizing": "auto"
        }
    },
    "rich-text#tablet--center-text--title": {
        "props": {
            "text": "!WATCH",
            "blockClass": "center-text--title"
        }
    },
    "rich-text#tablet--center-text--subtitle": {
        "props": {
            "text": "ULTRA 2",
            "blockClass": "center-text--subtitle"
        }
    },
    "rich-text#tablet--center-text--description": {
        "props": {
            "text": "An amazing product.",
            "blockClass": "center-text--description"
        }
    },
    "link#tablet--center-text--button-shop": {
        "props": {
            "href": "/",
            "label": " "
        }
    }
}