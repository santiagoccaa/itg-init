{
    "flex-layout.row#tablet__hero": {
        "title": "hero section",
        "children": [
            "image#tablet__hero__image-left",
            "flex-layout.col#tablet__hero__texts-center",
            "image#tablet__hero__image-right"
        ],
        "props": {
            "blockClass": "tablet__hero"
        }
    },
    "image#tablet__hero__image-left": {
        "title": "Image hero section left",
        "props": {
            "src": "assets/img/hero/img-left.svg",
            "blockClass": "hero__image"
        }
    },
    "image#tablet__hero__image-right": {
        "title": "image hero section right",
        "props": {
            "src": "assets/img/hero/img-right.svg",
            "blockClass": "hero__image"
        }
    },
    "flex-layout.col#tablet__hero__texts-center": {
        "title": "title, subtitle, description hero section",
        "children": [
            "flex-layout.col#tablet__texts-center--content-texts"
        ]
    },
    "flex-layout.col#tablet__texts-center--content-texts": {
        "title": "contenedor del texto y botón comprar",
        "children": [
            "rich-text#tablet__content-texts--title",
            "rich-text#tablet__content-texts--subtitle",
            "rich-text#tablet__content-text--description",
            "link#tablet__hero--button-comprar"
        ],
        "props": {
            "blockClass": "tablet__texts-center--content-texts"
        }
    },
    "rich-text#tablet__content-texts--title": {
        "title": "titulo",
        "props": {
            "text": "!WATCH",
            "blockClass": "tablet__content-texts--title"
        }
    },
    "rich-text#tablet__content-texts--subtitle": {
        "title": "subtitulo",
        "props": {
            "text": "ULTRA 2",
            "blockClass": "tablet__content-texts--subtitle",
            "height":"5%"
        }
    },
    "rich-text#tablet__content-text--description": {
        "title": "description",
        "props": {
            "text": "an amazing product.",
            "blockClass": "tablet__content-text--description"
        }
    },
    "link#tablet__hero--button-comprar": {
        "title": "button comprar",
        "props": {
            "href": "/",
            "label": "Comprar",
            "blockClass": "comprar-button"
        }
    }
}