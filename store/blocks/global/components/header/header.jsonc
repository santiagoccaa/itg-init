{
    "responsive-layout.desktop#desktop__responsive__header": {
        "title":"desktop header",
        "children": [
            "flex-layout.row#desktop__header"
        ]
    },
    "flex-layout.row#desktop__header": {
        "title": "header content",
        "children": [
            "flex-layout.col#desktop__heades--menu"
        ],
        "props": {
            "blockClass": "desktop__header",
            "height": "168px"
        }
    },
    "flex-layout.col#desktop__heades--menu": {
        "title":"header navbar, categoris",
        "children": [
            "flex-layout.row#desktop__header--menu-upper",
            "flex-layout.row#desktop__header--menu-button"
        ],
        "props": {
            "blockClass": "desktop__heades--menu"
        }
    },
    "flex-layout.row#desktop__header--menu-upper": {
        "title": "desktop header content",
        "children": [
            "sticky-layout#desktop__menga-menu",
            "image#menu-upper--logo",
            "search-bar#menu-pper--search",
            "flex-layout.row#menu-upper--navbar",
            "image#menu-upper--cart",
            "login#menu-upper--button-login"
        ],
        "props": {
            "blockClass": "desktop_header--menu-upper",
            "colSizing": "auto"
        }
    },
    "image#menu-upper--logo": {
        "title": "logo it globers",
        "props": {
            "width": "32px",
            "height": "16px",
            "src": "assets/img/icons/icon.svg"
        }
    },
    "search-bar#menu-pper--search": {
        "title": "search navbar",
        "props": {
            "openAutocompleteOnFocus": false,
            "width": "280px",
            "placeholder": "Search products"
        }
    },
    "flex-layout.row#menu-upper--navbar": {
        "title": "navbar menu upper header",
        "children": [
            "rich-text#navbar-text1",
            "rich-text#navbar-text2",
            "rich-text#navbar-text3",
            "rich-text#navbar-text4",
            "rich-text#navbar-text5"
        ],
        "props": {
            "blockClass": "menu-upper-navbar",
            "colSizing": "auto"
        }
    },
    "rich-text#navbar-text1": {
        "props": {
            "text": "Tendencias de ITGlobers",
            "blockClass": "navbar-text"
        }
    },
    "rich-text#navbar-text2": {
        "props": {
            "text": "Colección del mes",
            "blockClass": "navbar-text"
        }
    },
    "rich-text#navbar-text3": {
        "props": {
            "text": "Ofertas enero",
            "blockClass": "navbar-text"
        }
    },
    "rich-text#navbar-text4": {
        "props": {
            "text": "Cyber Monday",
            "blockClass": "navbar-text"
        }
    },
    "rich-text#navbar-text5": {
        "props": {
            "text": "Never say never",
            "blockClass": "navbar-text"
        }
    },
    "image#menu-upper--cart": {
        "title": "Icono cart",
        "props": {
            "width": "20px",
            "height": "20px",
            "src": "assets/img/icons/delivery.svg"
        }
    },
    "login#menu-upper--button-login": {
        "title": "button login",
        "props": {
            "iconLabel": "Login",
            "emailAndPasswordTitle": "LOG-IN",
            "accessCodeTitle": "Acess Code LOG-IN",
            "emailPlaceholder": "e-mail",
            "passwordPlaceholder": "password",
            "optionsTitle": "LOG IN",
            "showPasswordVerificationIntoTooltip": true,
            "formTitle": "LOG IN"
        }
    },
    "flex-layout.row#desktop__header--menu-button": {
        "children": [
            "flex-layout.row#desktop__header--menu-categorys"
        ],
        "props": {
            "blockClass": "desktop__header--menu-button",
            "width": "280px",
            "height": "40px"
        }
    },
    "flex-layout.row#desktop__header--menu-categorys": {
        "children": [
            "flex-layout.col#menu-categorys#1",
            "flex-layout.col#menu-categorys#2",
            "flex-layout.col#menu-categorys#3",
            "flex-layout.col#menu-categorys#4",
            "flex-layout.col#menu-categorys#5",
            "flex-layout.col#menu-categorys#6",
            "flex-layout.col#menu-categorys#7",
            "flex-layout.col#menu-categorys#8",
            "flex-layout.col#menu-categorys#9",
            "flex-layout.col#menu-categorys#10",
            "flex-layout.col#menu-categorys#11",
            "flex-layout.col#menu-categorys#12"
        ],
        "props": {
            "blockClass": "desktop__header--menu-categorys",
            "colSizing": "auto"
        }
    },
    "flex-layout.col#menu-categorys#1": {
        "children": [
            "image#category--image#1",
            "rich-text#category--text#1"
        ],
        "props": {
            "blockClass": "menu-categorys"
        }
    },
    "image#category--image#1": {
        "title": "logo it globers",
        "props": {
            "width": "20px",
            "height": "20px",
            "src": "assets/img/header/fastfood.svg"
        }
    },
    "rich-text#category--text#1": {
        "props": {
            "text": "Food",
            "blockClass": "category--text"
        }
    },
