{
    "flex-layout.row#desktop__slider": {
        "children": [
            "flex-layout.col#slider--content"
        ],
        "props": {
            "blockClass": "slider--content"
        }
    },
    "flex-layout.col#slider--content": {
        "children": [
            "rich-text#desktop__slider--content-title",
            "slider-layout#desktop__slider"
        ]
    },
    "rich-text#desktop__slider--content-title": {
        "title": "title section slider",
        "props": {
            "text": "An amazing product.",
            "blockClass": "desktop__slider--content-title"
        }
    },
    "slider-layout#desktop__slider": {
        "title": "Slider home",
        "props": {
            "itemsPerPage": {
                "desktop": 3,
                "tablet": 2,
                "phone": 1
            },
            "infinite": true,
            "blockClass": "desktop__slider",
            "centerModeSlidesGap": "to-the-left",
            "centerMode":"to-the-left"
        },
        "children": [
            "flex-layout.row#slider--card-1",
            "flex-layout.row#slider--card-2",
            "flex-layout.row#slider--card-3",
            "flex-layout.row#slider--card-4",
            "flex-layout.row#slider--card-5",
