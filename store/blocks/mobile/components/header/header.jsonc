{
    "flex-layout.row#mobile__header": {
        "title":"Hero content header mobile",
        "children": [
            "flex-layout.col#header--content-header"
        ],
        "props":{
            "blockClass":"mobile__header-contain"
        }
    },
    "flex-layout.col#header--content-header": {
        "title":"content menus top and bottom",
        "children": [
            "flex-layout.row#mobile__header--header-top",
            "flex-layout.row#mobile__header--header-bottom"
        ]
    },
    "flex-layout.row#mobile__header--header-top": {
        "title":"top menu header",
        "children": [
            "flex-layout.row#mobile__heade--content",
            "flex-layout.row#header--login-cart"
        ],
        "props": {
            "blockClass": "mobile__header",
            "colSizing": "auto"
        }
    },
    "flex-layout.row#mobile__heade--content": {
        "title":"logo and menu",
        "children": [
            "image#mobile__logo__icon-menu",
            "image#mobile__logo__icon"
        ],
        "props": {
            "blockClass": "mobile__heade--content"
        }
    },
    "image#mobile__logo__icon-menu": {
        "title":"imagen logo",
        "props": {
            "src": "assets/icons/menu.svg",
            "width": "24px",
            "height": "24px"
        }
    },
    "image#mobile__logo__icon": {
        "title":"imagen icon",
        "props": {
            "src": "assets/icons/icon.svg",
            "width": "24px",
            "height": "24px"
        }
    },
    "flex-layout.row#header--login-cart": {
        "title":"icon search, cart an button login",
        "children": [
            "link#header--search",
            "link#header--delivery",
            "link#mobile__button-login"
        ],
        "props": {
            "blockClass": "header--login-cart",
            "colSizing": "auto"
        }
    },
    "link#header--search": {
        "children": [
            "image#login-cart--search"
        ],
        "props": {
            "blockClass": "header--delivery"
        }
    },
    "image#login-cart--search": {
        "props": {
            "src": "assets/icons/hpa-search.svg",
            "width": "30px",
            "height": "30px"
        }
    },
    "link#header--delivery": {
        "children": [
            "image#login-cart--delivery"
        ],
        "props": {
            "blockClass": "header--delivery"
        }
    },
    "image#login-cart--delivery": {
        "props": {
            "src": "assets/icons/cart.svg",
            "width": "30px",
            "height": "30px"
        }
    },
    "link#mobile__button-login": {
        "props": {
            "href": "/",
            "label": "Login",
            "blockClass": "mobile__button-login",
            "width": "80px"
        }
    },
    "flex-layout.row#mobile__header--categorys": {
        "title": "Category Navigation",
        "children": [
            "flex-layout.col#categorys--food"
        ],
        "props": {
            "blockClass": "mobile__header--categorys",
            "colSizing": "70px"
        }
    },
    "flex-layout.col#categorys--food": {
        "children": [
            "image#food--icon",
            "rich-text#food-label"
        ],
        "props": {
            "blockClass": ""
        }
    },
    "image#categorys--food--icon": {
        "props": {
            "src": "assets/img/navbar/fastfood.svg",
            "width": "20px",
            "height": "20px"
        }
    },
    "rich-text#categorys--food-label": {
        "props": {
            "text": "Food",
            "blockClass": ""
        }
    },
    "flex-layout.row#mobile__header--header-bottom": {
        "children": [
            "flex-layout.col#bottom-menu__category--food",
            "flex-layout.col#bottom-menu__category--fitness",
            "flex-layout.col#bottom-menu__category--arctic",
            "flex-layout.col#bottom-menu__category--poolday",
            "flex-layout.col#bottom-menu__category--hotel"
        ],
        "props": {
            "blockClass": "mobile__header--header-bottom"
        }
    }
}