{
    "flex-layout.row#mobile__hero": {
        "title": "contentainer hero section home",
        "children": [
            "flex-layout.col#hero__content--hero"
        ]
    },
    "flex-layout.col#hero__content--hero": {
        "title": "content hero section",
        "children": [
            "flex-layout.col#hero__content-text",
            "image#hero--image",
            "link#hero__content--button"
        ],
        "props": {
            "blockClass": "hero__content--hero"
        }
    },
    "image#hero--image": {
        "title": "mobile hero image",
        "props": {
            "src": "assets/img/hero/img-left.svg",
            "blockClass": "hero--image"
        }
    },
    "flex-layout.col#hero__content-text": {
        "title": "contenedor del texto",
        "children": [
            "rich-text#hero__content-text--title",
            "rich-text#hero__content-text--subtitle",
            "rich-text#hero__content-text--description"
        ],
        "props": {
            "blockClass": "hero__content-text"
        }
    },
    "rich-text#hero__content-text--title": {
        "title": "titulo",
        "props": {
            "text": "!WATCH",
            "blockClass": "hero__content-text--title"
        }
    },
    "rich-text#hero__content-text--subtitle": {
        "title": "subtitulo",
        "props": {
            "text": "ULTRA 2",
            "blockClass": "hero__content-text--subtitle",
            "height": "5%"
        }
    },
    "rich-text#hero__content-text--description": {
        "title": "description",
        "props": {
            "text": "an amazing product.",
            "blockClass": "hero__content-text--description"
        }
    },
    "link#hero__content--button": {
        "title": "button hero section",
        "children": [
            "image#button-icon"
        ],
        "props":{
            "blockClass":"hero__content-button"
        }
    },
    "image#button-icon": {
        "props": {
            "src": "assets/icons/nav-arrow--right.svg"
        }
    }
}